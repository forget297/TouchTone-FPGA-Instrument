// Official Sipeed Tang Nano 20K pin labels = FPGA package numbers, NOT header indices.
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33;
IO_LOC "reset_button" 87;
IO_PORT "reset_button" IO_TYPE=LVCMOS33;
IO_LOC "mode_button" 88;
IO_PORT "mode_button" IO_TYPE=LVCMOS33;
IO_LOC "i2c_scl" 27;
IO_PORT "i2c_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "i2c_sda" 28;
IO_PORT "i2c_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// R3: abandon external connection to pin25; pin77 shared with unused LCD clock.
IO_LOC "enc_a" 77;
IO_PORT "enc_a" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// R4: B moved off pin26 to unused LCD_R4 pin41. No LCD attached.
IO_LOC "enc_b" 41;
IO_PORT "enc_b" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "enc_sw" 29;
IO_PORT "enc_sw" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "joy_sw" 30;
IO_PORT "joy_sw" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led_ser" 31;
IO_PORT "led_ser" IO_TYPE=LVCMOS33;
IO_LOC "led_srclk" 48;
IO_PORT "led_srclk" IO_TYPE=LVCMOS33;
IO_LOC "led_rclk" 49;
IO_PORT "led_rclk" IO_TYPE=LVCMOS33;
IO_LOC "i2s_bclk" 56;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33;
IO_LOC "i2s_ws" 55;
IO_PORT "i2s_ws" IO_TYPE=LVCMOS33;
IO_LOC "i2s_data" 54;
IO_PORT "i2s_data" IO_TYPE=LVCMOS33;
IO_LOC "pa_en" 51;
IO_PORT "pa_en" IO_TYPE=LVCMOS33;
IO_LOC "led_n[0]" 15;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33;
IO_LOC "led_n[1]" 16;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33;
IO_LOC "led_n[2]" 17;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33;
IO_LOC "led_n[3]" 18;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33;
IO_LOC "led_n[4]" 19;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33;
IO_LOC "led_n[5]" 20;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33;
IO_LOC "debug_gate" 74;
IO_PORT "debug_gate" IO_TYPE=LVCMOS33;
IO_LOC "debug_audio" 75;
IO_PORT "debug_audio" IO_TYPE=LVCMOS33;
// BLE coprocessor UART. Official V1.3 schematic: J5 pin20=FPGA52,
// J5 pin19=FPGA53. Both are exposed 3.3V Bank 3 pins shared with HDMI EDID.
IO_LOC "ble_uart_rx" 52;
IO_PORT "ble_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "ble_uart_tx" 53;
IO_PORT "ble_uart_tx" IO_TYPE=LVCMOS33;
